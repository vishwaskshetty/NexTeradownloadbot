# Telegram Bot Token
BOT_TOKEN=your_telegram_bot_token

# Environment & Server Port (Railway automatically sets PORT)
NODE_ENV=production
PORT=3000

# PostgreSQL Database Connection String
# For Supabase: use transaction pooler (port 6543) with sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://user:password@host:6543/dbname?sslmode=require&pgbouncer=true

# Direct (non-pooled) Supabase connection for Prisma migrations (port 5432)
# Required when schema.prisma has directUrl = env("DIRECT_URL")
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Redis Cache & Queue Connection
REDIS_URL=redis://default:password@host:6379
REDIS_TLS=false

# Shortener & Verification
SHORTENER_PROVIDER=arolinks
SHORTENER_API_KEY=your_arolinks_api_key
VERIFICATION_VALIDITY_MINUTES=15

# Telegram Bot Details
BOT_USERNAME=NexTeraDownloadBot

# Admin Telegram User IDs (comma separated)
ADMIN_TELEGRAM_IDS=6059191947

# Daily Usage Limits
FREE_DAILY_LIMIT=5
PREMIUM_DAILY_LIMIT=50

# Storage Channel Configuration (optional)
STORAGE_CHANNEL_ID=your_storage_channel_id
STORAGE_RETENTION_HOURS=24

# Referral System Settings
REFERRAL_ENABLED=true
REFERRALS_REQUIRED=10
REFERRAL_REWARD_DAYS=5

# TeraBox API & Session Cookie Options (optional)
TERABOX_CLIENT_ID=your_terabox_client_id
TERABOX_CLIENT_SECRET=your_terabox_client_secret
TERABOX_ACCESS_TOKEN=your_terabox_access_token
TERABOX_REFRESH_TOKEN=your_terabox_refresh_token
TERABOX_NDUS=your_terabox_ndus_cookie
TERABOX_GATEWAY_URL=your_optional_terabox_gateway_url