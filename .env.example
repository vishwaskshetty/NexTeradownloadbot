BOT_TOKEN=your_telegram_bot_token

DATABASE_URL=your_supabase_postgresql_connection_string

REDIS_URL=your_upstash_redis_url
REDIS_TLS=true

SHORTENER_PROVIDER=arolinks
SHORTENER_API_KEY=your_arolinks_api_key

VERIFICATION_BASE_URL=https://your-verification-domain.com
VERIFICATION_VALIDITY_MINUTES=1440

ADMIN_TELEGRAM_IDS=your_telegram_id

FREE_DAILY_LIMIT=5
PREMIUM_DAILY_LIMIT=50

# Storage
STORAGE_CHANNEL_ID=your_storage_channel_id
STORAGE_RETENTION_HOURS=24

# TeraBox Official API
TERABOX_CLIENT_ID=your_terabox_client_id
TERABOX_CLIENT_SECRET=your_terabox_client_secret
TERABOX_ACCESS_TOKEN=your_terabox_access_token
