{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "api/index.ts"
    },
    {
      "src": "/admin/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/verify/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
