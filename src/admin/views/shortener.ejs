<% const currentPath = '/admin/shortener'; %>
<%- include('partials/header', { currentPath }) %>

<div class="max-w-3xl mx-auto">
  <div class="mb-8">
    <h2 class="text-3xl font-bold text-white mb-2">Shortener Integration</h2>
    <p class="text-slate-400">Configure your link shortener for the verification flow.</p>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">
    <div class="flex items-center justify-between mb-8 pb-8 border-b border-slate-800">
      <div>
        <h3 class="text-xl font-bold text-white mb-1">Status</h3>
        <p class="text-slate-400 text-sm">Shortener integration is currently <%= isEnabled ? 'active' : 'disabled' %>.</p>
      </div>
      <form action="/admin/shortener/toggle" method="POST">
        <button type="submit" class="px-6 py-2 rounded-xl text-sm font-medium transition <%= isEnabled ? 'bg-red-500/10 text-red-400 hover:bg-red-500/20' : 'bg-green-500/10 text-green-400 hover:bg-green-500/20' %>">
          <%= isEnabled ? 'Disable Shortener' : 'Enable Shortener' %>
        </button>
      </form>
    </div>

    <div class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-slate-400 mb-2">Provider</label>
        <div class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-white">
          <%= provider || 'Not configured' %>
        </div>
      </div>
      
      <div>
        <label class="block text-sm font-medium text-slate-400 mb-2">API Key</label>
        <div class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-slate-300 font-mono text-sm">
          <%= apiKey ? apiKey.substring(0, 4) + '*'.repeat(16) + apiKey.substring(apiKey.length - 4) : 'Missing in .env' %>
        </div>
        <p class="text-xs text-slate-500 mt-2">API keys are loaded directly from your .env file.</p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
