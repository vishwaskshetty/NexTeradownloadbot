<% const currentPath = '/admin/dashboard'; %>
<%- include('partials/header', { currentPath }) %>

<div class="mb-8">
  <h2 class="text-3xl font-bold text-white mb-2">Dashboard</h2>
  <p class="text-slate-400">Overview of your bot's current status and activity.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <!-- Status Card -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 relative overflow-hidden group">
    <div class="absolute top-0 right-0 w-32 h-32 bg-green-500/10 rounded-full blur-3xl -mr-16 -mt-16 transition-all group-hover:bg-green-500/20"></div>
    <div class="text-green-400 mb-2">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    </div>
    <h3 class="text-slate-400 text-sm font-medium mb-1">Bot Status</h3>
    <div class="text-2xl font-bold text-white">Online</div>
  </div>

  <!-- Users Card -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 relative overflow-hidden group">
    <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full blur-3xl -mr-16 -mt-16 transition-all group-hover:bg-blue-500/20"></div>
    <div class="text-blue-400 mb-2">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
    </div>
    <h3 class="text-slate-400 text-sm font-medium mb-1">Total Users</h3>
    <div class="text-2xl font-bold text-white"><%= totalUsers %></div>
  </div>

  <!-- Premium Card -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 relative overflow-hidden group">
    <div class="absolute top-0 right-0 w-32 h-32 bg-purple-500/10 rounded-full blur-3xl -mr-16 -mt-16 transition-all group-hover:bg-purple-500/20"></div>
    <div class="text-purple-400 mb-2">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
    </div>
    <h3 class="text-slate-400 text-sm font-medium mb-1">Premium Users</h3>
    <div class="text-2xl font-bold text-white"><%= premiumUsers %></div>
  </div>

  <!-- Jobs Card -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 relative overflow-hidden group">
    <div class="absolute top-0 right-0 w-32 h-32 bg-orange-500/10 rounded-full blur-3xl -mr-16 -mt-16 transition-all group-hover:bg-orange-500/20"></div>
    <div class="text-orange-400 mb-2">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
    </div>
    <h3 class="text-slate-400 text-sm font-medium mb-1">Active Downloads</h3>
    <div class="text-2xl font-bold text-white"><%= activeJobs %></div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Today's Activity -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
    <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
      <span class="text-brand">⚡</span> Today's Activity
    </h3>
    <div class="space-y-4">
      <div class="flex items-center justify-between p-4 bg-slate-800/50 rounded-xl">
        <span class="text-slate-300">Downloads Today</span>
        <span class="text-xl font-bold text-white"><%= downloadsToday %></span>
      </div>
      <div class="flex items-center justify-between p-4 bg-slate-800/50 rounded-xl">
        <span class="text-slate-300">Verified Users</span>
        <span class="text-xl font-bold text-white"><%= verifiedUsers %></span>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
