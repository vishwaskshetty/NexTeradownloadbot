<% const currentPath = '/admin/broadcast'; %>
<%- include('partials/header', { currentPath }) %>

<div class="max-w-3xl mx-auto">
  <div class="mb-8">
    <h2 class="text-3xl font-bold text-white mb-2">Broadcast Message</h2>
    <p class="text-slate-400">Send an announcement to all bot users.</p>
  </div>

  <% if (success) { %>
    <div class="bg-green-500/10 border border-green-500/30 text-green-400 p-4 rounded-xl mb-8 flex items-start gap-3">
      <span class="text-xl">✅</span>
      <div>
        <h4 class="font-bold">Broadcast Queued</h4>
        <p class="text-sm">Your message has been added to the queue and will be delivered to users shortly.</p>
      </div>
    </div>
  <% } %>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">
    <form action="/admin/broadcast" method="POST">
      <div class="mb-6">
        <label class="block text-sm font-medium text-slate-300 mb-2">Message Content (Markdown supported)</label>
        <textarea name="message" rows="8" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition resize-none placeholder-slate-500" placeholder="Hello everyone! 👋&#10;&#10;We have just released an awesome new feature..."></textarea>
      </div>
      
      <div class="bg-brand/10 border border-brand/20 rounded-xl p-4 mb-6 text-sm text-brand flex gap-3 items-start">
        <span class="text-lg">ℹ️</span>
        <p>Broadcasting respects Telegram's rate limits. It will take some time to reach all users if you have a large user base.</p>
      </div>

      <button type="submit" class="w-full bg-brand hover:bg-blue-600 text-white font-bold py-3 px-6 rounded-xl transition shadow-lg shadow-brand/20" onclick="return confirm('Are you sure you want to broadcast this message to ALL users? This action cannot be undone.')">
        Send Broadcast
      </button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
