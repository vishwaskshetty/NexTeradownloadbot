<% const currentPath = '/admin/verification'; %>
<%- include('partials/header', { currentPath }) %>

<div class="max-w-3xl mx-auto">
  <div class="mb-8">
    <h2 class="text-3xl font-bold text-white mb-2">Verification Settings</h2>
    <p class="text-slate-400">Control link verification requirements for free users.</p>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 mb-8">
    <div class="flex items-center justify-between mb-8 pb-8 border-b border-slate-800">
      <div>
        <h3 class="text-xl font-bold text-white mb-1">Global Verification</h3>
        <p class="text-slate-400 text-sm">When enabled, free users must pass a shortener link to use the bot.</p>
      </div>
      <div class="flex flex-col items-end">
        <span class="mb-3 px-4 py-1.5 rounded-full text-sm font-medium <%= isEnabled ? 'bg-green-500/20 text-green-400 border border-green-500/30' : 'bg-red-500/20 text-red-400 border border-red-500/30' %>">
          Status: <%= isEnabled ? 'ACTIVE' : 'DISABLED' %>
        </span>
        <form action="/admin/verification/toggle" method="POST">
          <button type="submit" class="px-6 py-2 rounded-xl text-sm font-medium transition <%= isEnabled ? 'bg-slate-800 text-white hover:bg-slate-700' : 'bg-brand text-white hover:bg-brand/90' %>">
            <%= isEnabled ? 'Disable Verification' : 'Enable Verification' %>
          </button>
        </form>
      </div>
    </div>

    <div>
      <h3 class="text-lg font-medium text-white mb-4">Configuration</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-slate-800/50 rounded-xl p-4 border border-slate-700/50">
          <div class="text-slate-400 text-sm mb-1">Validity Period</div>
          <div class="text-2xl font-bold text-white"><%= validity %> <span class="text-base font-normal text-slate-500">minutes</span></div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
