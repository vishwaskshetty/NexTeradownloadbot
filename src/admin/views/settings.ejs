<% const currentPath = '/admin/settings'; %>
<%- include('partials/header', { currentPath }) %>

<div class="max-w-3xl mx-auto">
  <div class="mb-8">
    <h2 class="text-3xl font-bold text-white mb-2">Bot Settings</h2>
    <p class="text-slate-400">General configuration for your bot instance.</p>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
    <div class="p-6 border-b border-slate-800 flex items-center justify-between">
      <div>
        <h3 class="text-lg font-medium text-white mb-1">Database & Services</h3>
        <p class="text-sm text-slate-400">Environment configurations</p>
      </div>
    </div>
    <div class="p-6 space-y-4">
      <div class="flex justify-between items-center py-2 border-b border-slate-800/50">
        <span class="text-slate-300">PostgreSQL Status</span>
        <span class="text-green-400 font-medium text-sm flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-green-400"></span> Connected
        </span>
      </div>
      <div class="flex justify-between items-center py-2 border-b border-slate-800/50">
        <span class="text-slate-300">Redis / BullMQ Status</span>
        <span class="text-green-400 font-medium text-sm flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-green-400"></span> Connected
        </span>
      </div>
      <div class="flex justify-between items-center py-2">
        <span class="text-slate-300">Telegram Polling</span>
        <span class="text-green-400 font-medium text-sm flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-green-400"></span> Active
        </span>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
